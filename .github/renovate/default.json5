{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "packageRules": [
    {
      "description": "mise tools: fuzzy selectors (latest, prefix pins) update mise.lock only",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "mise tools: concrete pins also update mise.toml",
      "matchManagers": ["mise"],
      "matchCurrentVersion": "/^\\d/",
      "groupName": "mise tools (pinned)"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
