FROM registry.fedoraproject.org/fedora-minimal:44

RUN useradd --create-home --shell /bin/fish --uid 1000 --user-group sbx

RUN mkdir -p /workspace /home/sbx/.config /home/sbx/.local/share \
  && chown -R "sbx:sbx" /workspace /home/sbx/.config /home/sbx/.local

RUN --mount=type=cache,target=/var/cache/libdnf5 \
  dnf install -y fish git

RUN --mount=type=cache,target=/var/cache/libdnf5 \
  dnf install -y procps-ng iproute


ENTRYPOINT []
CMD ["/bin/fish"]
